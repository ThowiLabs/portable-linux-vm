+// Blink uses its host POSIX user IDs by default. On Windows the host UID
+// is an opaque CRT ID, e.g. 554, and has no meaning in /etc/passwd.
+// The bundled OCI Debian and Alpine images expect Linux UID/GID 0.
+// This is GUEST IDENTITY ONLY; never change the host process token.
+static bool PortableBoxGuestRoot(void) {
+#ifdef __COSMOPOLITAN__
+  return IsWindows();
+#else
+  return false;
+#endif
+}
+
+static bool PortableBoxIsRootOrUnchanged(u32 id) {
+  return id == 0 || id == (u32)-1;
+}
+
 static int SysGetuid(struct Machine *m) {
-  return getuid();
+  return PortableBoxGuestRoot() ? 0 : getuid();
 }
 
 static int SysGetgid(struct Machine *m) {
-  return getgid();
+  return PortableBoxGuestRoot() ? 0 : getgid();
 }
 
 static int SysGeteuid(struct Machine *m) {
-  return geteuid();
+  return PortableBoxGuestRoot() ? 0 : geteuid();
 }
 
 static int SysGetegid(struct Machine *m) {
-  return getegid();
+  return PortableBoxGuestRoot() ? 0 : getegid();
 }
 
 static i32 SysGetgroups(struct Machine *m, i32 size, i64 addr) {
+  if (PortableBoxGuestRoot()) {
+    if (size == 0) return 1;  // primary root group
+    if (size < 1) return einval();
+    if (!IsValidMemory(m, addr, sizeof(u32), PROT_WRITE)) return -1;
+    u8 rootgid[4];
+    Write32(rootgid, 0);
+    CopyToUserWrite(m, addr, rootgid, sizeof(rootgid));
+    return 1;
+  }
   gid_t *group;
   u8 i32buf[4];
   int i, ngroups;
@@ -5041,6 +5069,9 @@
 }
 
 static i32 SysSetgroups(struct Machine *m, i32 size, i64 addr) {
+  // Changing the guest groups must never change Windows process groups.
+  // Until fully virtualized group mutation is implemented, reject it.
+  if (PortableBoxGuestRoot()) return enosys();
 #ifdef HAVE_SETGROUPS
   int i;
   gid_t *group;
