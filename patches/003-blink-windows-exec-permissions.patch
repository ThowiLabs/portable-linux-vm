+  if (!(st->st_mode & 0111) && !IsBinFile(prog)
+#ifdef __COSMOPOLITAN__
+      && !IsWindows()
+#endif
+      ) {
     LOGF("execve needs chmod +x");
     errno = EACCES;
     return -1;
@@ -707,6 +717,7 @@
     // PortableBox diagnostics: failure stage instead of an ambiguous EIO.
     const char *loadstage = "open";
     bool loadok = false;
+    memset(&st, 0, sizeof(st));
     fd = VfsOpen(AT_FDCWD, prog, O_RDONLY, 0);
     if (fd != -1) {
       loadstage = "fstat";
@@ -730,8 +741,11 @@
                                      mapsize - total, total);
                 if (n <= 0) {
                   if (!n) errno = EIO;
+                  const int readerrno = errno;
+                  Munmap(map, mapsize);
                   map = MAP_FAILED;
                   loadstage = "read-after-mmap";
+                  errno = readerrno;
                   break;
                 }
                 total += n;
@@ -747,11 +761,13 @@
       }
     }
     if (!loadok) {
-      fprintf(stderr, "PortableBox diagnostic: loader stage=%s errno=%d\n",
-              loadstage, errno);
+      // Save errno before fprintf: Windows terminal output may overwrite it.
+      const int reason = errno;
+      fprintf(stderr, "PortableBox diagnostic: loader stage=%s errno=%d, mode=%o\n",
+              loadstage, reason, (unsigned)st.st_mode);
       WriteErrorString(prog);
       WriteErrorString(": failed to load executable (errno ");
-      FormatInt64(tmp, errno);
+      FormatInt64(tmp, reason);
       WriteErrorString(tmp);
       WriteErrorString(")\n");
       exit(127);
