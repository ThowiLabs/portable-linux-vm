--- a/blink/loader.c
+++ b/blink/loader.c
@@ -28,6 +28,9 @@
 #include <sys/stat.h>
 #include <sys/types.h>
 #include <unistd.h>
+#ifdef __COSMOPOLITAN__
+#include <libc/dce.h>
+#endif
 
 #include "blink/assert.h"
 #include "blink/biosrom.h"
@@ -553,7 +556,14 @@
     errno = EACCES;
     return -1;
   }
-  if (!(st->st_mode & 0111) && !IsBinFile(prog)) {
+  // Win32 file modes do not preserve the Unix executable bit for ELF
